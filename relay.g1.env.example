# Relay config FOR THE G1 (PC2). The Go2's is relay.env.example; same keys, and only
# ROBOT_MODEL and the clamps differ (lower: first remote drives of a humanoid — see
# src/g1_command_sender.cpp).
#   cp relay.g1.env.example relay.env
# Command relay config. Copy to relay.env and edit; the systemd unit reads it, so changing
# a value needs no root and no touching /etc/systemd.
#
#   cp relay.env.example relay.env
#   printf '%s' "$(head -c 32 /dev/urandom | base64)" > ~/.relay_token && chmod 600 ~/.relay_token
#   sudo systemctl restart robot-command-relay
#
# relay.env is gitignored: it is per-deployment, and a `git pull` must not overwrite it.

# --- Where to listen -------------------------------------------------------------------
# Only the VPN-facing path should reach this. NEVER expose it to the internet: this is the
# one service in the project that can make the robot walk.
RELAY_BIND=0.0.0.0
RELAY_PORT=8092

# --- Safety limits ---------------------------------------------------------------------
# Velocity ceilings, enforced inside command_sender no matter what the caller asks for.
MAX_VX=0.3
MAX_VY=0.2
MAX_VYAW=0.5

# A movement must be refreshed within this window or the robot is stopped automatically.
# Lower = safer but requires the caller to send keepalives more often.
# 1000 since 2026-09-23. Over UDP the executor refreshes every 100 ms, so one second rides
# out ~9 lost datagrams in a row; the worst run measured over Starlink was 4 (~280 ms).
DEADMAN_MS=1000

# --- Continuous teleop over UDP ---------------------------------------------------------
# `move` and `stop_move` only, HMAC-authenticated with the relay token; every other verb
# stays on HTTP. 0 or empty = off. Must match RELAY_UDP_PORT in the executor's environment.
# WHY: over Starlink every HTTP command costs a fresh TCP connection (178 ms median, and a
# lost SYN costs a whole second). A lost datagram is simply replaced by the next one.
RELAY_UDP_PORT=8097

# Commands per second accepted before returning 429.
MAX_PER_SEC=20

# --- Misc ------------------------------------------------------------------------------
DDS_IFACE=eth0
AUDIT_LOG=/var/tmp/robot-relay-audit.log
RELAY_TOKEN_FILE=/home/unitree/.relay_token
# SENDER_BIN is derived from ROBOT_MODEL (./g1_command_sender). Set it only to run a binary
# outside the repo dir; its file name must still be <robot>_command_sender or the relay refuses.
ROBOT_MODEL=g1

# --- Waist lock -------------------------------------------------------------------------
# Set in the Unitree app, and this relay cannot read it, so declare it here. It picks the ONE
# walk the relay offers: 1 = waist locked (1-DoF) -> `start`, FSM 500; anything else = waist
# free (3-DoF) -> `walk_waist`, FSM 501. Both read off the bus 2026-10-01. Change it whenever
# the lock changes in the app, then restart the relay.
G1_WAIST_LOCK=1
