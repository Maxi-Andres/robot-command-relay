# Command relay config. Copy to relay.env and edit; the systemd unit reads it, so changing
# a value needs no root and no touching /etc/systemd.
#
#   cp relay/relay.env.example relay/relay.env
#   printf '%s' "$(head -c 32 /dev/urandom | base64)" > ~/.relay_token && chmod 600 ~/.relay_token
#   sudo systemctl restart robot-command-relay
#
# relay.env is gitignored: it is per-deployment, and a `git pull` must not overwrite it.

# --- Where to listen -------------------------------------------------------------------
# Only the VPN-facing path should reach this. NEVER expose it to the internet: this is the
# one service in the project that can make the robot walk.
RELAY_BIND=0.0.0.0
RELAY_PORT=8092

# --- Safety limits ---------------------------------------------------------------------
# Velocity ceilings, enforced inside command_sender no matter what the caller asks for.
MAX_VX=0.6
MAX_VY=0.4
MAX_VYAW=1.0

# A movement must be refreshed within this window or the robot is stopped automatically.
# Lower = safer but requires the caller to send keepalives more often.
DEADMAN_MS=1500

# Commands per second accepted before returning 429.
MAX_PER_SEC=20

# --- Misc ------------------------------------------------------------------------------
DDS_IFACE=eth0
AUDIT_LOG=/var/tmp/robot-relay-audit.log
RELAY_TOKEN_FILE=/home/unitree/.relay_token
SENDER_BIN=/home/unitree/robot-command-relay/command_sender
